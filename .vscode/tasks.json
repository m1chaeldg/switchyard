{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build (switchyard-app)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--package", "switchyard-app", "--bin", "switchyard"],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "cargo build (switchyard-cli)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--package", "switchyard-cli", "--bin", "swy"],
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo",
      "args": ["check", "--workspace"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace"],
      "problemMatcher": ["$rustc"],
      "group": "test"
    }
  ]
}
